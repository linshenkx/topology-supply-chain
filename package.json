{
  "name": "topology-supply-chain",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-vinext.mjs dev",
    "dev:api": "pnpm --filter @topology/api dev",
    "build": "node scripts/run-vinext.mjs build",
    "build:web:preview": "pnpm build",
    "build:web:production": "pnpm build:aliyun",
    "build:contracts": "pnpm --filter @topology/contracts build",
    "build:api": "pnpm --filter @topology/contracts build && pnpm --filter @topology/api build:code",
    "build:worker": "pnpm --filter @topology/worker build",
    "build:all": "pnpm build:web:production && pnpm build:api && pnpm build:worker",
    "build:aliyun": "node scripts/build-aliyun.mjs",
    "start": "node scripts/run-vinext.mjs start",
    "start:aliyun": "next start",
    "typecheck:web": "tsc --noEmit --incremental false",
    "typecheck:api": "tsc -p apps/api/tsconfig.json --noEmit --incremental false",
    "typecheck:worker": "tsc -p apps/worker/tsconfig.json --noEmit --incremental false",
    "typecheck:contracts": "tsc -p packages/contracts/tsconfig.json --noEmit --incremental false",
    "typecheck": "pnpm build:contracts && pnpm typecheck:web && pnpm typecheck:contracts && pnpm typecheck:api && pnpm typecheck:worker",
    "test": "pnpm test:root",
    "test:root": "pnpm build:web:preview && node scripts/run-test-suite.mjs root && node scripts/run-web-system-test.mjs",
    "test:api": "pnpm build:api && node scripts/run-test-suite.mjs api",
    "test:worker": "pnpm build:worker && node scripts/run-test-suite.mjs worker",
    "test:contracts": "pnpm typecheck:contracts",
    "test:system": "node scripts/run-web-system-test.mjs",
    "test:non-mysql": "pnpm build:web:preview && pnpm build:api && pnpm build:worker && node scripts/run-test-suite.mjs non-mysql && node scripts/run-web-system-test.mjs",
    "test:mysql": "pnpm build:api && pnpm build:worker && node scripts/run-test-suite.mjs mysql",
    "test:all": "pnpm test:non-mysql && pnpm test:mysql",
    "lint": "eslint .",
    "lint:baseline": "node scripts/check-eslint-baseline.mjs",
    "docker:check-context": "node scripts/check-docker-context.mjs",
    "deploy:check-env-contract": "node scripts/check-environment-contract.mjs",
    "verify:local": "pnpm typecheck && pnpm lint:baseline && pnpm docker:check-context && pnpm deploy:check-env-contract && pnpm test:non-mysql && pnpm build:web:production",
    "verify:mysql": "pnpm typecheck && pnpm test:mysql",
    "verify": "pnpm verify:local && pnpm verify:mysql",
    "db:generate": "drizzle-kit generate",
    "db:generate:mysql-schema": "node scripts/generate-mysql-schema.mjs",
    "db:generate:mysql": "drizzle-kit generate --config drizzle.mysql.config.ts && node scripts/normalize-mysql-identifiers.mjs",
    "db:normalize:mysql": "node scripts/normalize-mysql-identifiers.mjs",
    "deploy:check-env": "node scripts/check-production-env.mjs",
    "db:migrate:mysql": "drizzle-kit migrate --config drizzle.mysql.config.ts",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@alicloud/credentials": "2.4.1",
    "@alicloud/dysmsapi20170525": "^4.6.0",
    "@alicloud/openapi-core": "^1.0.8",
    "ali-oss": "^6.23.0",
    "drizzle-orm": "0.45.2",
    "mysql2": "^3.23.2",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/ali-oss": "^6.23.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
