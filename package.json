{
  "name": "topology-supply-chain",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:api": "pnpm --filter @topology/api dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:api": "pnpm --filter @topology/contracts build && pnpm --filter @topology/api build:code",
    "build:worker": "pnpm --filter @topology/worker build",
    "build:aliyun": "node scripts/build-aliyun.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:aliyun": "next start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:api": "pnpm --filter @topology/api test",
    "test:worker": "pnpm --filter @topology/worker test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:generate:mysql-schema": "node scripts/generate-mysql-schema.mjs",
    "db:generate:mysql": "drizzle-kit generate --config drizzle.mysql.config.ts && node scripts/normalize-mysql-identifiers.mjs",
    "db:normalize:mysql": "node scripts/normalize-mysql-identifiers.mjs",
    "deploy:check-env": "node scripts/check-production-env.mjs",
    "db:migrate:mysql": "drizzle-kit migrate --config drizzle.mysql.config.ts",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@alicloud/credentials": "2.4.1",
    "@alicloud/dysmsapi20170525": "^4.6.0",
    "@alicloud/openapi-core": "^1.0.8",
    "ali-oss": "^6.23.0",
    "drizzle-orm": "0.45.2",
    "mysql2": "^3.23.2",
    "next": "16.2.6",
    "proxy-agent": "^8.0.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/ali-oss": "^6.23.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
