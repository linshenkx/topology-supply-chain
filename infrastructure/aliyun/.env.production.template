# topology-scm-v2 UAT。真实文件只保存在本机和服务器，不提交 Git。
PROJECT_ROOT=/opt/topology-scm-v2
HTTP_PORT=18080
WEB_IMAGE=registry.cn-guangzhou.aliyuncs.com/bigdata200/my-opc-workbench:topology-scm-web-<git-sha>
BACKEND_IMAGE=registry.cn-guangzhou.aliyuncs.com/bigdata200/my-opc-workbench:topology-scm-backend-<git-sha>

DATABASE_URL=mysql://Topology_scm_app:<password>@<rds-host>:3306/topology_scm_v2
DB_POOL_SIZE=10
WORKER_DB_POOL_SIZE=5
DB_SSL=disabled
DB_SSL_REJECT_UNAUTHORIZED=false

API_SESSION_SIGNING_KEY=replace-with-at-least-32-random-bytes
OTP_SEALING_KEY=replace-with-64-hex-characters

LOCAL_FIXTURE_RUN_ID=uat
LOCAL_FIXTURE_PASSWORD=replace-with-at-least-12-characters
