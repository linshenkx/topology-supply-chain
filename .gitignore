# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/e2e-runtime/

# next.js
**/.next/
**/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.*.example
!deploy/**/.env.*.template

# vercel
.vercel

# typescript
next-env.d.ts
**/dist/
**/.wrangler/
/outputs/
/work/

# local caches and generated packages
/.pnpm-store/
/.tmp/
/build/
/backups/
/archive/**
!/archive/README.md
!/archive/manifests/
!/archive/manifests/**
!/archive/source-snapshots/
!/archive/source-snapshots/stage9-t2-legacy-routes-228de77b.tar
*.tar.gz
*.zip
*.tsbuildinfo
