APP_BASE_URL=https://scm.example.com
APP_ENV=production
DEPLOY_TARGET=aliyun

SESSION_SECRET=replace-with-at-least-32-random-bytes
API_SESSION_SIGNING_KEY=replace-with-a-distinct-at-least-32-byte-secret
OTP_SEALING_KEY_ID=v1
OTP_SEALING_KEY=replace-with-64-hex-characters
OTP_SEALING_KEYS_JSON={"v1":"replace-with-64-hex-characters"}
JOB_TOKEN=replace-with-a-different-random-token

DATABASE_URL=mysql://replace-app-user:replace-password@replace-rds-internal-host:3306/topology_scm
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=5000
DB_PING_TIMEOUT_MS=2000
DB_QUERY_TIMEOUT_MS=5000
DB_TRANSACTION_TIMEOUT_MS=30000
DB_SSL=enabled
DB_SSL_REJECT_UNAUTHORIZED=true
WORKER_DB_POOL_SIZE=5

# The API image contains the approved Scope A R2/R3 manifests. Keep this value
# synchronized with deploy/aliyun/docker-compose.yml; deployment tests fail if
# either manifest is omitted.
DOMAIN_REGISTRATION_MODULES=../modules/r2-master-procurement/index.js,../r3/manifest.js

OSS_REGION=oss-cn-your-region
OSS_BUCKET=replace-private-bucket
OSS_ECS_RAM_ROLE=replace-ecs-ram-role
OSS_INTERNAL_ENDPOINT=true
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

SMS_WEBHOOK_URL=
SMS_WEBHOOK_API_KEY=
SMS_WEBHOOK_HEALTH_URL=
SMS_ECS_RAM_ROLE=replace-ecs-ram-role
SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_SIGN_NAME=replace-approved-sign-name
ALIYUN_SMS_TEMPLATE_CODE=SMS_REPLACE_AFTER_APPROVAL

EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_API_KEY=
EMAIL_WEBHOOK_HEALTH_URL=
FILE_SCAN_WEBHOOK_URL=
FILE_SCAN_WEBHOOK_API_KEY=
FILE_SCAN_WEBHOOK_HEALTH_URL=

OPENAI_API_KEY=

# Writer activation is intentionally not configured here. The allowlist and
# hashed drain/reconciliation/approval/observability evidence are supplied only
# to the explicit scripts/activate-writers.sh invocation; ordinary deploys keep
# the allowlist empty and never change writer_fences.
