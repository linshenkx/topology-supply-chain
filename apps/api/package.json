{
  "name": "@topology/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm --filter @topology/contracts build && tsx watch src/server.ts",
    "build": "pnpm --filter @topology/contracts build && pnpm run build:code",
    "build:code": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "@topology/contracts": "workspace:*",
    "ali-oss": "6.23.0",
    "fastify": "5.11.3",
    "mysql2": "3.23.2",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/ali-oss": "6.23.3",
    "@types/node": "22.19.19",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
