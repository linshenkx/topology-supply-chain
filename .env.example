# Public application
APP_BASE_URL=http://localhost:3000
APP_ENV=development
DEPLOY_TARGET=local

# Session and scheduled jobs. Generate two independent random values.
SESSION_SECRET=replace-with-at-least-32-random-bytes
API_SESSION_SIGNING_KEY=replace-with-a-distinct-at-least-32-byte-secret
JOB_TOKEN=replace-with-a-different-random-token

# MySQL 8
DATABASE_URL=mysql://scm_app:replace-password@127.0.0.1:3306/topology_scm
DB_POOL_SIZE=10
DB_SSL=disabled
DB_SSL_REJECT_UNAUTHORIZED=true

# Alibaba Cloud OSS
OSS_REGION=oss-cn-your-region
OSS_BUCKET=replace-private-bucket
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Set true only when ECS and OSS use the same region and an internal endpoint.
OSS_INTERNAL_ENDPOINT=false

# Alibaba Cloud SMS
SMS_WEBHOOK_URL=
SMS_WEBHOOK_API_KEY=
SMS_ECS_RAM_ROLE=
SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_SIGN_NAME=replace-approved-sign-name
ALIYUN_SMS_TEMPLATE_CODE=SMS_REPLACE_AFTER_APPROVAL

# Email adapter
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_API_KEY=

# Optional embedded AI assistant
OPENAI_API_KEY=
